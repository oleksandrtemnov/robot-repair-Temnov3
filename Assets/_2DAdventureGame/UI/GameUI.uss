.root { flex-grow: 1; }
.overlay-template { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.health-frame { position: absolute; left: 18px; top: 14px; width: 260px; height: 120px; -unity-background-scale-mode: scale-to-fit; }
.portrait { position: absolute; left: 20px; top: 18px; width: 80px; height: 88px; -unity-background-scale-mode: scale-to-fit; }
.health-container { position: absolute; left: 108px; top: 40px; width: 140px; height: 37px; overflow: hidden; }
.health { width: 100%; height: 100%; -unity-background-scale-mode: stretch-to-fill; }
.progress-panel { position: absolute; right: 22px; top: 22px; width: 300px; height: 76px; background-image: url("../Art/Ruby/UI/UIDialogueBox.png"); -unity-background-scale-mode: stretch-to-fill; }
.progress { flex-grow: 1; padding: 14px 24px; color: rgb(25, 28, 32); font-size: 22px; -unity-text-align: middle-center; }
.hint { position: absolute; left: 50%; margin-left: -250px; top: 16px; width: 500px; height: 90px; padding: 15px 24px; background-image: url("../Art/Ruby/UI/UIDialogueBox.png"); -unity-background-scale-mode: stretch-to-fill; color: rgb(25, 28, 32); font-size: 21px; -unity-text-align: middle-center; white-space: normal; -unity-font-style: bold; display: none; }
.dialogue { position: absolute; left: 18%; right: 18%; bottom: 22px; height: 145px; -unity-background-scale-mode: stretch-to-fill; }
.dialogue-text { flex-grow: 1; margin: 0; padding: 26px 35px; font-size: 21px; color: rgb(34, 30, 25); white-space: normal; -unity-text-align: middle-left; }
.end { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: black; opacity: 0; display: none; transition-property: opacity; transition-duration: 1s; }
.end-art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.end-caption { position: absolute; bottom: 28px; left: 0; right: 0; color: white; -unity-text-align: middle-center; font-size: 22px; }
